{
  "name": "91writing-backend",
  "version": "1.0.0",
  "description": "91Writing 商业化后端服务 - NestJS微服务架构",
  "author": "91Writing Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build && npm run build:services",
    "build:services": "npx nest build api-gateway && npx nest build auth-service && npx nest build user-service && npx nest build novel-service && npx nest build ai-service && npx nest build payment-service && npx nest build admin-service",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:auth": "node dist/apps/auth-service/main",
    "start:auth:dev": "nest start auth-service --watch",
    "start:user": "node dist/apps/user-service/main",
    "start:user:dev": "nest start user-service --watch",
    "start:novel": "node dist/apps/novel-service/main",
    "start:novel:dev": "nest start novel-service --watch",
    "start:ai": "node dist/apps/ai-service/main",
    "start:ai:dev": "nest start ai-service --watch",
    "start:gateway": "node dist/apps/api-gateway/main",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:payment": "node dist/apps/payment-service/main",
    "start:payment:dev": "nest start payment-service --watch",
    "start:admin": "node dist/apps/admin-service/main",
    "start:admin:dev": "nest start admin-service --watch",
    "start:all": "npm run build:services && concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:user\" \"npm run start:novel\" \"npm run start:ai\" \"npm run start:payment\" \"npm run start:admin\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPattern=spec.ts",
    "test:integration": "jest --testPathPattern=integration.spec.ts",
    "test:perf": "node test/performance/quick-test.js",
    "test:perf:detailed": "node test/performance/quick-test.js --concurrent 20 --duration 60",
    "test:load": "artillery run test/performance/load-test.yml",
    "test:stress": "artillery run test/performance/stress-test.yml",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "check:services": "./scripts/check-services.sh",
    "show:ports": "cat PORT-REFERENCE.txt"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/cache-manager": "^2.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.0",
    "bull": "^4.11.0",
    "cache-manager": "^5.0.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "concurrently": "^8.2.0",
    "dotenv": "^17.2.2",
    "helmet": "^7.0.0",
    "mysql2": "^3.6.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^5.0.0",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "artillery": "^2.0.26",
    "cross-env": "^10.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "webpack-cli": "^6.0.1"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
