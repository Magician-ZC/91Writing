// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== 用户系统 =====
// 用户基础表
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  nickname      String?
  passwordHash  String     @map("password_hash")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  isActive      Boolean    @default(true) @map("is_active")
  emailVerified Boolean    @default(false) @map("email_verified")
  lastLoginAt   DateTime?  @map("last_login_at")

  // 邀请系统字段
  inviteCode  String  @unique @map("invite_code") // 用户专属邀请码
  invitedBy   String? @map("invited_by") // 邀请者ID
  inviteCount Int     @default(0) @map("invite_count") // 邀请人数统计

  // 多租户字段 (暂时保留，后续可能用于企业版)
  tenantId String? @map("tenant_id")

  // 关联
  profile         UserProfile?
  subscription    Subscription?
  novels          Novel[]
  activities      UserActivity[]
  materials       Material[]
  prompts         Prompt[]
  paymentOrders   PaymentOrder[]
  aiUsageLogs     AIUsageLog[]

  // 邀请关系
  inviter         User?          @relation("UserInvites", fields: [invitedBy], references: [id])
  invitees        User[]         @relation("UserInvites")
  sentInvites     UserInvite[]   @relation("InviterRelation")
  receivedInvites UserInvite[]   @relation("InviteeRelation")
  inviteRewards   InviteReward[]

  // 协作关系
  collaborations  NovelCollaboration[]
  chapterLocks    ChapterLock[]
  editEvents      ChapterEditEvent[]
  chapterVersions ChapterVersion[]
  comments        ChapterComment[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([tenantId])
  @@index([inviteCode])
  @@index([invitedBy])
  @@map("users")
}

// 用户资料表
model UserProfile {
  userId       String  @id @map("user_id")
  nickname     String?
  avatar       String?
  bio          String? @db.Text
  preferences  Json? // 用户偏好设置
  writingStats Json?   @map("writing_stats") // 写作统计

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ===== 商业系统 =====
// 套餐配置表
model Package {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?       @db.Text
  price        Decimal       @db.Decimal(10, 2)
  durationDays Int           @map("duration_days")
  features     Json // 套餐功能配置
  sortOrder    Int           @default(0) @map("sort_order")
  status       PackageStatus @default(ACTIVE)

  // 关联
  subscriptions   Subscription[]
  paymentOrders   PaymentOrder[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

// 用户订阅表
model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  packageId Int                @map("package_id")
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  autoRenew Boolean            @default(false) @map("auto_renew")

  // 关联
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}


// 支付订单表
model PaymentOrder {
  id            Int           @id @default(autoincrement())
  orderNo       String        @unique @map("order_no")
  userId        String        @map("user_id")
  packageId     Int           @map("package_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at")
  expiresAt     DateTime      @map("expires_at")
  transactionId String?       @map("transaction_id") // 第三方支付流水号

  // 关联
  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderNo])
  @@index([userId, status])
  @@index([status])
  @@map("payment_orders")
}

// ===== 创作系统 =====
// 小说基础表
model Novel {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  title        String      @db.VarChar(200)
  description  String?     @db.Text
  genre        String?     @db.VarChar(50)
  status       NovelStatus @default(DRAFT)
  coverUrl     String?     @map("cover_url") @db.VarChar(500)
  wordCount    Int         @default(0) @map("word_count")
  chapterCount Int         @default(0) @map("chapter_count")
  settings     Json? // 小说设置(角色、世界观等)

  // 关联
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters       Chapter[]
  memories       NovelMemory[]
  collaborations NovelCollaboration[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([genre])
  @@index([status])
  @@map("novels")
}

// 章节表
model Chapter {
  id            String        @id @default(cuid())
  novelId       String        @map("novel_id")
  title         String        @db.VarChar(200)
  content       String        @db.LongText
  wordCount     Int           @default(0) @map("word_count")
  chapterNumber Int           @map("chapter_number")
  status        ChapterStatus @default(DRAFT)

  // 关联
  novel      Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  lock       ChapterLock?
  editEvents ChapterEditEvent[]
  versions   ChapterVersion[]
  comments   ChapterComment[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([novelId, chapterNumber])
  @@index([novelId, status])
  @@map("chapters")
}

// 记忆系统表
model NovelMemory {
  id           String     @id @default(cuid())
  novelId      String     @map("novel_id")
  memoryType   MemoryType @map("memory_type")
  content      Json
  importance   Decimal    @default(0.5) @db.Decimal(3, 2)
  tokenCost    Int        @default(0) @map("token_cost")
  chapterRange String?    @map("chapter_range") @db.VarChar(50)

  // 关联
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([novelId, memoryType])
  @@index([importance])
  @@map("novel_memories")
}

// ===== 协作系统 =====
// 小说协作表
model NovelCollaboration {
  id            String              @id @default(cuid())
  novelId       String              @map("novel_id")
  userId        String              @map("user_id")
  role          CollaborationRole   @default(VIEWER)
  status        CollaborationStatus @default(PENDING)
  inviteMessage String?             @map("invite_message") @db.Text

  // 关联
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([novelId, userId])
  @@index([novelId])
  @@index([userId])
  @@index([status])
  @@map("novel_collaborations")
}

// 章节锁定表
model ChapterLock {
  id        String   @id @default(cuid())
  chapterId String   @unique @map("chapter_id")
  userId    String   @map("user_id")
  isLocked  Boolean  @default(true) @map("is_locked")
  lockedAt  DateTime @default(now()) @map("locked_at")

  // 关联
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chapterId])
  @@index([userId])
  @@map("chapter_locks")
}

// 章节编辑事件表
model ChapterEditEvent {
  id        String   @id @default(cuid())
  chapterId String   @map("chapter_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type") @db.VarChar(50)
  eventData Json     @map("event_data")

  // 关联
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chapterId])
  @@index([userId])
  @@index([createdAt])
  @@map("chapter_edit_events")
}

// 章节版本表
model ChapterVersion {
  id            String  @id @default(cuid())
  chapterId     String  @map("chapter_id")
  versionNumber Int     @map("version_number")
  title         String  @db.VarChar(200)
  content       String? @db.LongText
  wordCount     Int     @default(0) @map("word_count")
  userId        String  @map("user_id") // 创建此版本的用户
  changeLog     String? @map("change_log") @db.Text

  // 关联
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chapterId, versionNumber])
  @@index([chapterId])
  @@index([userId])
  @@map("chapter_versions")
}

// 章节评论表
model ChapterComment {
  id         String        @id @default(cuid())
  chapterId  String        @map("chapter_id")
  userId     String        @map("user_id")
  content    String        @db.Text
  position   Json? // 评论位置信息（段落、字符位置等）
  status     CommentStatus @default(ACTIVE)
  parentId   String?       @map("parent_id") // 父评论ID（用于回复）

  // 关联
  chapter Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ChapterComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ChapterComment[] @relation("CommentReplies")

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chapterId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
  @@map("chapter_comments")
}

// ===== 素材系统 =====
// 素材表
model Material {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  name        String       @db.VarChar(200)
  type        MaterialType
  category    String?      @db.VarChar(50)
  fileUrl     String?      @map("file_url") @db.VarChar(500)
  fileSize    Int?         @map("file_size")
  description String?      @db.Text
  tags        Json?
  usageCount  Int          @default(0) @map("usage_count")

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, type])
  @@index([category])
  @@index([type])
  @@map("materials")
}

// 提示词表
model Prompt {
  id         String  @id @default(cuid())
  userId     String? @map("user_id") // null表示系统提示词
  title      String  @db.VarChar(200)
  content    String  @db.Text
  category   String? @db.VarChar(50)
  tags       Json?
  isPublic   Boolean @default(false) @map("is_public")
  usageCount Int     @default(0) @map("usage_count")
  rating     Decimal @default(0) @db.Decimal(3, 2)

  // 关联
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublic])
  @@index([rating])
  @@index([userId])
  @@map("prompts")
}

// ===== 统计分析 =====
// 用户行为日志表
model UserActivity {
  id         BigInt  @id @default(autoincrement())
  userId     String? @map("user_id")
  action     String  @db.VarChar(100)
  targetType String? @map("target_type") @db.VarChar(50)
  targetId   String? @map("target_id")
  details    Json?
  ipAddress  String? @map("ip_address") @db.VarChar(45)
  userAgent  String? @map("user_agent") @db.Text

  // 关联
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, action])
  @@index([createdAt])
  @@index([action])
  @@map("user_activities")
}

// AI使用统计表
model AIUsageLog {
  id           BigInt  @id @default(autoincrement())
  userId       String? @map("user_id")
  model        String  @db.VarChar(50)
  functionType String  @map("function_type") @db.VarChar(50)
  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  cost         Decimal @default(0) @db.Decimal(10, 4)
  responseTime Int?    @map("response_time") // 响应时间 (毫秒)
  success      Boolean @default(true)

  // 关联
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, functionType])
  @@index([createdAt])
  @@index([model])
  @@map("ai_usage_logs")
}

// 系统配置表
model SystemConfig {
  id          Int     @id @default(autoincrement())
  configKey   String  @unique @map("config_key") @db.VarChar(100)
  configValue Json    @map("config_value")
  description String? @db.Text

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([configKey])
  @@map("system_configs")
}

// ===== 枚举定义 =====
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}


enum PaymentMethod {
  ALIPAY
  WECHAT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum NovelStatus {
  DRAFT
  WRITING
  COMPLETED
  PUBLISHED
}

enum ChapterStatus {
  DRAFT
  PUBLISHED
}

enum MemoryType {
  CORE
  SUMMARY
  CONTEXT
}

enum MaterialType {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEXT
}

// ===== 邀请系统表 =====
// 邀请记录表
model UserInvite {
  id           String       @id @default(cuid())
  inviterId    String       @map("inviter_id") // 邀请者ID
  inviteeId    String       @map("invitee_id") // 被邀请者ID
  status       InviteStatus @default(PENDING)
  rewardStatus RewardStatus @default(PENDING) @map("reward_status")

  // 关联
  inviter User           @relation("InviterRelation", fields: [inviterId], references: [id])
  invitee User           @relation("InviteeRelation", fields: [inviteeId], references: [id])
  rewards InviteReward[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inviterId, inviteeId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([status])
  @@map("user_invites")
}

// 邀请奖励记录表
model InviteReward {
  id          String       @id @default(cuid())
  userId      String       @map("user_id") // 获得奖励的用户ID
  inviteId    String       @map("invite_id") // 邀请记录ID
  rewardType  RewardType   @map("reward_type") // 奖励类型
  amount      Decimal      @db.Decimal(10, 2) // 奖励数量
  status      RewardStatus @default(PENDING)
  description String? // 奖励描述

  // 关联
  user   User       @relation(fields: [userId], references: [id])
  invite UserInvite @relation(fields: [inviteId], references: [id])

  // 时间戳
  createdAt DateTime  @default(now()) @map("created_at")
  grantedAt DateTime? @map("granted_at") // 奖励发放时间

  @@index([userId])
  @@index([inviteId])
  @@index([status])
  @@map("invite_rewards")
}

// ===== 邀请系统枚举 =====
enum InviteStatus {
  PENDING // 待确认
  ACCEPTED // 已接受
  REJECTED // 已拒绝
  EXPIRED // 已过期
}

enum RewardStatus {
  PENDING // 待发放
  GRANTED // 已发放
  FAILED // 发放失败
  CANCELLED // 已取消
}

enum RewardType {
  POINTS // 积分奖励
  DAYS // 天数奖励
  PACKAGE // 套餐奖励
  CASH // 现金奖励
}

// ===== 协作系统枚举 =====
enum CollaborationRole {
  OWNER // 所有者
  EDITOR // 编辑者
  COMMENTER // 评论者
  VIEWER // 查看者
}

enum CollaborationStatus {
  ACTIVE // 活跃
  PENDING // 待确认
  REVOKED // 已撤销
}

enum CommentStatus {
  ACTIVE // 活跃
  RESOLVED // 已解决
  DELETED // 已删除
}
