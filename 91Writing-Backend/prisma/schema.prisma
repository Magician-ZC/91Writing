// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== 用户系统 =====
// 用户基础表
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  username     String?     @unique
  nickname     String?
  passwordHash String      @map("password_hash")
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  isActive     Boolean     @default(true) @map("is_active")
  emailVerified Boolean    @default(false) @map("email_verified")
  lastLoginAt  DateTime?   @map("last_login_at")
  
  // 多租户字段 (暂时保留，后续可能用于企业版)
  tenantId     String?     @map("tenant_id")
  
  // 关联
  profile         UserProfile?
  subscription    Subscription?
  novels          Novel[]
  activities      UserActivity[]
  materials       Material[]
  prompts         Prompt[]
  activationCodes ActivationCode[]
  paymentOrders   PaymentOrder[]
  aiUsageLogs     AIUsageLog[]
  
  // 时间戳
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  
  @@map("users")
  @@index([email])
  @@index([username])
  @@index([status])
  @@index([tenantId])
}

// 用户资料表
model UserProfile {
  userId       String  @id @map("user_id")
  nickname     String?
  avatar       String?
  bio          String? @db.Text
  preferences  Json?   // 用户偏好设置
  writingStats Json?   @map("writing_stats") // 写作统计
  
  // 关联
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

// ===== 商业系统 =====
// 套餐配置表
model Package {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?        @db.Text
  price       Decimal        @db.Decimal(10, 2)
  durationDays Int           @map("duration_days")
  features    Json           // 套餐功能配置
  sortOrder   Int            @default(0) @map("sort_order")
  status      PackageStatus  @default(ACTIVE)
  
  // 关联
  subscriptions   Subscription[]
  activationCodes ActivationCode[]
  paymentOrders   PaymentOrder[]
  
  // 时间戳
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  @@map("packages")
}

// 用户订阅表
model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique @map("user_id")
  packageId   Int                @map("package_id")
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  autoRenew   Boolean            @default(false) @map("auto_renew")
  
  // 关联
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  package     Package            @relation(fields: [packageId], references: [id])
  
  // 时间戳
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  
  @@map("subscriptions")
  @@index([status])
  @@index([endDate])
}

// 激活码表
model ActivationCode {
  id          Int                    @id @default(autoincrement())
  code        String                 @unique
  packageId   Int                    @map("package_id")
  status      ActivationCodeStatus   @default(UNUSED)
  usedBy      String?                @map("used_by")
  usedAt      DateTime?              @map("used_at")
  expiresAt   DateTime?              @map("expires_at")
  createdBy   String                 @map("created_by") // 创建者ID (管理员)
  
  // 关联
  package     Package                @relation(fields: [packageId], references: [id])
  user        User?                  @relation(fields: [usedBy], references: [id])
  
  // 时间戳
  createdAt   DateTime               @default(now()) @map("created_at")
  
  @@map("activation_codes")
  @@index([code])
  @@index([status])
  @@index([expiresAt])
}

// 支付订单表
model PaymentOrder {
  id            Int                @id @default(autoincrement())
  orderNo       String             @unique @map("order_no")
  userId        String             @map("user_id")
  packageId     Int                @map("package_id")
  amount        Decimal            @db.Decimal(10, 2)
  paymentMethod PaymentMethod      @map("payment_method")
  status        PaymentStatus      @default(PENDING)
  paidAt        DateTime?          @map("paid_at")
  expiresAt     DateTime           @map("expires_at")
  transactionId String?            @map("transaction_id") // 第三方支付流水号
  
  // 关联
  user          User               @relation(fields: [userId], references: [id])
  package       Package            @relation(fields: [packageId], references: [id])
  
  // 时间戳
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  
  @@map("payment_orders")
  @@index([orderNo])
  @@index([userId, status])
  @@index([status])
}

// ===== 创作系统 =====
// 小说基础表
model Novel {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  title        String      @db.VarChar(200)
  description  String?     @db.Text
  genre        String?     @db.VarChar(50)
  status       NovelStatus @default(DRAFT)
  coverUrl     String?     @map("cover_url") @db.VarChar(500)
  wordCount    Int         @default(0) @map("word_count")
  chapterCount Int         @default(0) @map("chapter_count")
  settings     Json?       // 小说设置(角色、世界观等)
  
  // 关联
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  memories     NovelMemory[]
  
  // 时间戳
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  
  @@map("novels")
  @@index([userId, status])
  @@index([genre])
  @@index([status])
}

// 章节表
model Chapter {
  id            String        @id @default(cuid())
  novelId       String        @map("novel_id")
  title         String        @db.VarChar(200)
  content       String        @db.LongText
  wordCount     Int           @default(0) @map("word_count")
  chapterNumber Int           @map("chapter_number")
  status        ChapterStatus @default(DRAFT)
  
  // 关联
  novel         Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  // 时间戳
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  
  @@map("chapters")
  @@unique([novelId, chapterNumber])
  @@index([novelId, status])
}

// 记忆系统表
model NovelMemory {
  id           String     @id @default(cuid())
  novelId      String     @map("novel_id")
  memoryType   MemoryType @map("memory_type")
  content      Json
  importance   Decimal    @db.Decimal(3, 2) @default(0.5)
  tokenCost    Int        @default(0) @map("token_cost")
  chapterRange String?    @map("chapter_range") @db.VarChar(50)
  
  // 关联
  novel        Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  // 时间戳
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  
  @@map("novel_memories")
  @@index([novelId, memoryType])
  @@index([importance])
}

// ===== 素材系统 =====
// 素材表
model Material {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  name        String       @db.VarChar(200)
  type        MaterialType
  category    String?      @db.VarChar(50)
  fileUrl     String?      @map("file_url") @db.VarChar(500)
  fileSize    Int?         @map("file_size")
  description String?      @db.Text
  tags        Json?
  usageCount  Int          @default(0) @map("usage_count")
  
  // 关联
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 时间戳
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  @@map("materials")
  @@index([userId, type])
  @@index([category])
  @@index([type])
}

// 提示词表
model Prompt {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id") // null表示系统提示词
  title     String   @db.VarChar(200)
  content   String   @db.Text
  category  String?  @db.VarChar(50)
  tags      Json?
  isPublic  Boolean  @default(false) @map("is_public")
  usageCount Int     @default(0) @map("usage_count")
  rating    Decimal  @default(0) @db.Decimal(3, 2)
  
  // 关联
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("prompts")
  @@index([category])
  @@index([isPublic])
  @@index([rating])
  @@index([userId])
}

// ===== 统计分析 =====
// 用户行为日志表
model UserActivity {
  id         BigInt    @id @default(autoincrement())
  userId     String?   @map("user_id")
  action     String    @db.VarChar(100)
  targetType String?   @map("target_type") @db.VarChar(50)
  targetId   String?   @map("target_id")
  details    Json?
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  
  // 关联
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // 时间戳
  createdAt  DateTime  @default(now()) @map("created_at")
  
  @@map("user_activities")
  @@index([userId, action])
  @@index([createdAt])
  @@index([action])
}

// AI使用统计表
model AIUsageLog {
  id           BigInt    @id @default(autoincrement())
  userId       String?   @map("user_id")
  model        String    @db.VarChar(50)
  functionType String    @map("function_type") @db.VarChar(50)
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  cost         Decimal   @default(0) @db.Decimal(10, 4)
  responseTime Int?      @map("response_time") // 响应时间 (毫秒)
  success      Boolean   @default(true)
  
  // 关联
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // 时间戳
  createdAt    DateTime  @default(now()) @map("created_at")
  
  @@map("ai_usage_logs")
  @@index([userId, functionType])
  @@index([createdAt])
  @@index([model])
}

// 系统配置表
model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue Json     @map("config_value")
  description String?  @db.Text
  
  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("system_configs")
  @@index([configKey])
}

// ===== 枚举定义 =====
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ActivationCodeStatus {
  UNUSED
  USED
  EXPIRED
}

enum PaymentMethod {
  ALIPAY
  WECHAT
  ACTIVATION_CODE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum NovelStatus {
  DRAFT
  WRITING
  COMPLETED
  PUBLISHED
}

enum ChapterStatus {
  DRAFT
  PUBLISHED
}

enum MemoryType {
  CORE
  SUMMARY
  CONTEXT
}

enum MaterialType {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEXT
}
