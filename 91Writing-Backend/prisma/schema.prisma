// ===== 写作建议系统 =====
// 写作建议表
model WritingSuggestion {
  id             String              @id @default(cuid())
  novelId        String              @map("novel_id")
  chapterId      String?             @map("chapter_id")
  userId         String              @map("user_id") // 建议所属用户
  suggestionType SuggestionType      @map("suggestion_type")
  dimension      SuggestionDimension // 建议维度（剧情/人物/节奏等）
  title          String              @db.VarChar(200)
  content        String              @db.Text
  priority       Int                 @default(0) // 优先级评分 0-100
  context        Json? // 建议相关的上下文信息
  aiModel        String?             @map("ai_model") @db.VarChar(50) // 生成建议的AI模型

  // 采纳反馈
  isAdopted Boolean   @default(false) @map("is_adopted")
  adoptedAt DateTime? @map("adopted_at")
  feedback  String?   @db.Text // 用户反馈
  rating    Int? // 用户评分 1-5星

  // 关联
  novel   Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([novelId, suggestionType])
  @@index([chapterId])
  @@index([userId])
  @@index([isAdopted])
  @@index([dimension])
  @@map("writing_suggestions")
}

// 建议类型枚举
enum SuggestionType {
  AUTO // 自动生成
  REQUESTED // 用户请求
  SYSTEM // 系统推荐
}

// 建议维度枚举
enum SuggestionDimension {
  PLOT // 剧情相关
  CHARACTER // 人物相关
  PACING // 节奏相关
  DIALOGUE // 对话相关
  SCENE // 场景相关
  STYLE // 风格相关
  STRUCTURE // 结构相关
  CONFLICT // 冲突相关
  THEME // 主题相关
  OTHER // 其他
}

// ===== 角色系统 =====
// 角色表
model Character {
  id         String        @id @default(cuid())
  novelId    String        @map("novel_id")
  name       String        @db.VarChar(100)
  aliases    Json? // 别名/称号列表
  role       CharacterRole @default(SUPPORTING) // 角色定位
  importance Int           @default(50) // 重要性评分 0-100

  // 基本信息
  age        String? @db.VarChar(50)
  gender     String? @db.VarChar(20)
  occupation String? @db.VarChar(100)
  appearance String? @db.Text // 外貌描写

  // 性格特征
  personality String? @db.Text // 性格描写
  traits      Json? // 性格特质标签
  strengths   Json? // 优点列表
  weaknesses  Json? // 缺点列表

  // 背景设定
  background String? @db.Text // 背景故事
  motivation String? @db.Text // 动机目标
  arc        String? @db.Text // 角色弧光

  // 其他信息
  abilities    Json? // 能力/技能
  equipment    Json? // 装备/道具
  customFields Json? @map("custom_fields") // 自定义字段

  // 统计信息
  appearanceCount Int     @default(0) @map("appearance_count") // 出场次数
  lastAppearance  String? @map("last_appearance") // 最后出场章节

  // 关联
  novel             Novel                   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  relationshipsFrom CharacterRelationship[] @relation("CharacterFrom")
  relationshipsTo   CharacterRelationship[] @relation("CharacterTo")
  appearances       CharacterAppearance[]

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([novelId])
  @@index([novelId, role])
  @@index([novelId, importance])
  @@map("characters")
}

// 角色关系表
model CharacterRelationship {
  id               String             @id @default(cuid())
  novelId          String             @map("novel_id")
  fromCharId       String             @map("from_char_id")
  toCharId         String             @map("to_char_id")
  relationshipType String             @map("relationship_type") @db.VarChar(50) // 关系类型
  description      String?            @db.Text // 关系描述
  intimacy         Int                @default(50) // 亲密度 0-100
  status           RelationshipStatus @default(ACTIVE) // 关系状态

  // 关联
  novel    Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  fromChar Character @relation("CharacterFrom", fields: [fromCharId], references: [id], onDelete: Cascade)
  toChar   Character @relation("CharacterTo", fields: [toCharId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromCharId, toCharId])
  @@index([novelId])
  @@index([fromCharId])
  @@index([toCharId])
  @@map("character_relationships")
}

// 角色出场记录表
model CharacterAppearance {
  id          String @id @default(cuid())
  characterId String @map("character_id")
  chapterId   String @map("chapter_id")
  novelId     String @map("novel_id")
  scenes      Json? // 出场场景描述
  importance  Int    @default(50) // 此次出场重要性

  // 关联
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  novel     Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")

  @@index([characterId])
  @@index([chapterId])
  @@index([novelId])
  @@map("character_appearances")
}

// ===== 世界观系统 =====
// 世界观设定表
model WorldSetting {
  id          String        @id @default(cuid())
  novelId     String        @map("novel_id")
  category    WorldCategory // 世界观类别
  name        String        @db.VarChar(200)
  description String?       @db.Text
  details     Json? // 详细设定（结构化数据）

  // 位置信息（针对地点类）
  location    String? @db.VarChar(200)
  coordinates Json? // 坐标/位置关系

  // 组织信息（针对组织/势力类）
  leadership String? @db.Text // 领导层
  members    Json? // 成员信息
  power      Int?    @default(50) // 势力强度 0-100

  // 其他
  tags         Json? // 标签
  references   Json? // 相关引用
  customFields Json? @map("custom_fields")

  // 关联
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
