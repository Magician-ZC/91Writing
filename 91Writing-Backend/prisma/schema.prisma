  userId      String   @unique @map("user_id")
  
  dailyUsed   Int      @default(0) @map("daily_used")
  dailyLimit  Int      @default(5) @map("daily_limit")
  dailyResetAt DateTime @map("daily_reset_at")
  
  monthlyUsed Int      @default(0) @map("monthly_used")
  monthlyLimit Int     @default(50) @map("monthly_limit")
  monthlyResetAt DateTime @map("monthly_reset_at")
  
  totalGenerated Int   @default(0) @map("total_generated")
  totalCost   Float   @default(0.0) @map("total_cost")
  
