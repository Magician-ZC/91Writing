}

enum ConfigType {
  SYSTEM // 系统全局配置
  USER // 用户自定义配置
}

enum AITier {
  FREE // 免费额度
  BASIC // 基础会员
  PREMIUM // 高级会员
  UNLIMITED // 无限制
