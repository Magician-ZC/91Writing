// ===== 数据迁移系统 =====
// 数据迁移记录表
model DataMigration {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  migrationType  MigrationType   @map("migration_type") // 迁移类型
  status         MigrationStatus @default(PENDING) // 迁移状态
  totalItems     Int             @default(0) @map("total_items") // 总条目数
  processedItems Int             @default(0) @map("processed_items") // 已处理条目数
  successItems   Int             @default(0) @map("success_items") // 成功条目数
  failedItems    Int             @default(0) @map("failed_items") // 失败条目数
  errorLog       Json? // 错误日志
  sourceData     Json? // 源数据快照（用于回滚）
  metadata       Json? // 元数据

  // 时间戳
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@map("data_migrations")
}

// 迁移类型枚举
enum MigrationType {
  NOVELS // 小说数据
  CHAPTERS // 章节数据
  MEMORIES // 记忆数据
  CHARACTERS // 角色数据
  WORLD_SETTINGS // 世界观数据
  MATERIALS // 素材数据
  FULL // 全量迁移
}

// 迁移状态枚举
enum MigrationStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  COMPLETED // 已完成
  FAILED // 失败
  ROLLED_BACK // 已回滚
}

// ===== 视频生成系统 =====
// 一致性配置表
model ConsistencyProfile {
  id           String @id @default(cuid())
  novelId      String @unique @map("novel_id")
  characters   Json // 角色特征描述 {name: {baseAppearance, dynamicState, keywords, referenceImageUrl}}
  environments Json? // 环境/场景描述 {name: {description, visualStyle, keywords}}
  objects      Json? // 重要物品描述 {name: {description, appearance, keywords}}
  visualStyle  Json?  @map("visual_style") // 整体视觉风格配置 {overall, colorTone, artStyle, lighting}
  version      Int    @default(1) // 配置版本号
  
  // 自动管理标记
  autoExtracted    Boolean  @default(false) @map("auto_extracted")
  lastExtractedAt  DateTime? @map("last_extracted_at")
  autoUpdate       Boolean  @default(true) @map("auto_update")   // 是否自动更新
  updateHistory    Json?    @map("update_history")              // 更新历史记录

  // 关联
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([novelId])
  @@map("consistency_profiles")
}

// 角色特征数据库（由AI自动提取）
model CharacterFeature {
  id          String   @id @default(cuid())
  
  novelId     String   @map("novel_id")
  chapterNumber Int    @map("chapter_number")
  characterName String @map("character_name")
  
  // 自动提取的特征
  appearance  String   @db.Text  // 外貌描述（AI生成）
  clothing    String   @db.Text  // 服饰描述（AI生成）
  state       String?  @db.Text  // 状态描述（受伤、疲惫等）
  
  // 视觉化提示词（由Agent优化）
  visualPrompt   String  @map("visual_prompt") @db.Text
  negativePrompt String? @map("negative_prompt") @db.Text
  keywords       Json?   // 关键词列表
  
  // 一致性参考
  referenceImageUrl String? @map("reference_image_url") @db.VarChar(500)  // 生成的参考图
  referenceId       String? @map("reference_id")  // Provider的人物ID
  
  // 自动提取标记
  extractedBy String  @map("extracted_by")  // storyboard-agent | image-agent
  confidence  Float   @default(0.8)  // 提取置信度 0-1
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@unique([novelId, chapterNumber, characterName])
  @@index([novelId, characterName])
  @@index([novelId, chapterNumber])
  @@map("character_features")
}

// 视频生成日志表
model VideoGenerationLog {
  id           String            @id @default(cuid())
  chapterId    String            @map("chapter_id")
  stage        VideoGenStage     @default(SCRIPT) // 当前阶段
  status       VideoGenLogStatus @default(PROCESSING) // 日志状态
  details      Json? // 详细日志 {timestamp, action, result, metadata}
  errorMessage String?           @map("error_message") @db.Text
  retryCount   Int               @default(0) @map("retry_count") // 重试次数
  progress     Int               @default(0) // 进度百分比 0-100

  // 性能统计
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  duration    Int?      @default(0) // 耗时(秒)

  // 关联
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chapterId, stage])
  @@index([chapterId, status])
  @@index([status])
  @@map("video_generation_logs")
}

// Agent提示词配置表
model AgentPromptConfig {
  id             String    @id @default(cuid())
  agentType      AgentType @map("agent_type") // Agent类型
  name           String    @db.VarChar(200) // 配置名称
  systemPrompt   String    @map("system_prompt") @db.Text // 系统提示词
  templatePrompt String    @map("template_prompt") @db.Text // 模板提示词
  parameters     Json? // 附加参数配置
  version        Int       @default(1) // 版本号
  isActive       Boolean   @default(true) @map("is_active") // 是否启用
  description    String?   @db.Text // 配置描述

  // 统计信息
  usageCount   Int @default(0) @map("usage_count") // 使用次数
  successCount Int @default(0) @map("success_count") // 成功次数
  failureCount Int @default(0) @map("failure_count") // 失败次数

  // 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentType, version])
  @@index([agentType, isActive])
  @@index([isActive])
  @@map("agent_prompt_configs")
}

// ===== 视频生成系统枚举 =====
// 视频生成状态
enum VideoStatus {
