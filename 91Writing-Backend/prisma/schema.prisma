// ===== 视频API配置系统 =====
// 视频API配置表（管理员配置）
model VideoAPIConfig {
  id          String   @id @default(cuid())
  
  // API密钥（加密存储）
  volcengineAccessKeyId     String?  @map("volcengine_access_key_id") @db.Text
  volcengineSecretAccessKey String?  @map("volcengine_secret_access_key") @db.Text  // 加密
  jimengApiKey              String?  @map("jimeng_api_key") @db.Text  // 加密
  klingApiKey               String?  @map("kling_api_key") @db.Text  // 加密
  
  // Provider配置
  videoProvider      String  @default("jimeng") @map("video_provider")  // jimeng | kling
  
  // 路径配置
  ffmpegPath         String  @default("/usr/bin/ffmpeg") @map("ffmpeg_path")
  ffmpegPreset       String  @default("medium") @map("ffmpeg_preset")  // ultrafast | fast | medium | slow | veryslow
  videoStoragePath   String  @default("/data/videos") @map("video_storage_path")
  tempStoragePath    String  @default("/tmp/video-generation") @map("temp_storage_path")
  autoCleanTemp      Boolean @default(true) @map("auto_clean_temp")
  
  // 文生图配置
  imageGenConfig     Json?   @map("image_gen_config")  // 文生图参数配置
  // {
  //   "defaultResolution": "1024x576",
  //   "quality": "standard",
  //   "batchSize": 1,
  //   "samplingSteps": 30,
  //   "cfgScale": 7.5,
  //   "defaultStyle": "realistic",
  //   "globalNegativePrompt": "...",
  //   "enableConsistency": true,
  //   "timeout": 60
  // }
  
  // 图生视频配置
  videoGenConfig     Json?   @map("video_gen_config")  // 图生视频参数配置
  // {
  //   "defaultDuration": 5,
  //   "resolution": "1024x576",
  //   "fps": 30,
  //   "defaultMotionIntensity": "medium",
  //   "quality": "high",
  //   "compressionLevel": "medium",
  //   "transitionEffect": "fade",
  //   "transitionDuration": 0.5,
  //   "timeout": 120,
  //   "maxRetries": 2,
  //   "enableCharacterConsistency": true
  // }
  
  // 默认生成配置
  defaultGenConfig   Json?   @map("default_gen_config")  // 用户默认配置
  // {
  //   "defaultSceneCount": 5,
  //   "minSceneWords": 100,
  //   "defaultTotalDuration": 30,
  //   "addTitleFrame": true,
  //   "titleFrameDuration": 2
  // }
  
  // 成本控制
  userDailyQuota     Int     @default(5) @map("user_daily_quota")
  userMonthlyQuota   Int     @default(50) @map("user_monthly_quota")
  monthlyBudget      Float   @default(1000.0) @map("monthly_budget")
  costAlertThreshold Float   @default(800.0) @map("cost_alert_threshold")
  costPerImage       Float   @default(0.02) @map("cost_per_image")  // 单张图片成本
  costPerVideo       Float   @default(1.5) @map("cost_per_video")   // 单个视频成本
  
  // 并发和性能
  performanceConfig  Json?   @map("performance_config")  // 性能配置
  // {
  //   "maxConcurrentTasks": 3,
  //   "imageGenConcurrency": 2,
  //   "videoGenConcurrency": 1,
  //   "enableCache": false,
  //   "enableQueue": true
  // }
  
  // 健康检查
  isActive           Boolean @default(true) @map("is_active")
  lastHealthCheck    DateTime? @map("last_health_check")
  healthStatus       String? @map("health_status")
  
  // 审计信息
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  
  @@map("video_api_configs")
}

// API使用日志表
model VideoAPIUsageLog {
